<section class="krynn-settings">
  <fieldset>
    <legend>{{localize "KRYNN.Settings.Date.Legend"}}</legend>
    <p class="hint">{{localize "KRYNN.Settings.Date.Hint"}}</p>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Date.Period"}}</label>
      <div class="form-fields">
        <select name="period">
          {{#each periods}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}} ({{hint}})</option>{{/each}}
        </select>
        <button type="button" data-action="jumpToPeriod">{{localize "KRYNN.Settings.Date.Jump"}}</button>
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Date.Date"}}</label>
      <div class="form-fields">
        <input type="number" name="day" value="{{date.day}}" min="1" max="{{monthDays}}" step="1" aria-label="{{localize "KRYNN.Settings.Date.Day"}}">
        <select name="month" aria-label="{{localize "KRYNN.Settings.Date.Month"}}">
          {{#each months}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
        <input type="number" name="year" value="{{date.year}}" step="1" aria-label="{{localize "KRYNN.Settings.Date.Year"}}">
      </div>
      <p class="hint">{{localize "KRYNN.Settings.Date.YearHint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "KRYNN.Settings.Calendar.Legend"}}</legend>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Calendar.Style"}}</label>
      <div class="form-fields"><select name="calendarStyle">{{#each styles}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Calendar.Culture"}}</label>
      <div class="form-fields"><select name="worldCulture">{{#each cultures}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
      <p class="hint">{{localize "KRYNN.Settings.Calendar.CultureHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Calendar.Eye"}}</label>
      <div class="form-fields">
        <input type="number" name="eye.day" value="{{eye.day}}" min="1" max="{{monthDays}}" step="1" aria-label="{{localize "KRYNN.Settings.Date.Day"}}">
        <select name="eye.month" aria-label="{{localize "KRYNN.Settings.Date.Month"}}">{{#each eyeMonths}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <input type="number" name="eye.year" value="{{eye.year}}" step="1" aria-label="{{localize "KRYNN.Settings.Date.Year"}}">
      </div>
      <p class="hint">{{localize "KRYNN.Settings.Calendar.EyeHint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "KRYNN.Settings.Magic.Legend"}}</legend>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.MoonMagic.Label"}}</label>
      <div class="form-fields"><select name="moonMagic">{{#each moonMagic}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
      <p class="hint">{{localize "KRYNN.Settings.MoonMagic.Hint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Gods.Label"}}</label>
      <div class="form-fields"><select name="godsMode">{{#each gods}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
      <p class="hint">{{localize "KRYNN.Settings.Gods.Hint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.MoonMinLevel.Label"}}</label>
      <div class="form-fields"><input type="number" name="moonMinLevel" value="{{moonMinLevel}}" min="1" max="20" step="1"></div>
      <p class="hint">{{localize "KRYNN.Settings.MoonMinLevel.Hint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.HighSorcery.Label"}}</label>
      <div class="form-fields"><select name="hsMode">{{#each hs}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
      <p class="hint">{{localize "KRYNN.Settings.HighSorcery.Hint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Nuitari.Label"}}</label>
      <div class="form-fields"><select name="nuitariSeen">{{#each nuitari}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Announce.Label"}}</label>
      <div class="form-fields"><input type="checkbox" name="announce" {{#if announce}}checked{{/if}}></div>
      <p class="hint">{{localize "KRYNN.Settings.Announce.Hint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "KRYNN.Settings.Dragons.Legend"}}</legend>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Throes.Label"}}</label>
      <div class="form-fields"><select name="deathThroes">{{#each throes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
      <p class="hint">{{localize "KRYNN.Settings.Throes.Hint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Dragons.FearCards"}}</label>
      <div class="form-fields"><input type="checkbox" name="dragonfearCards" {{#if dragonfearCards}}checked{{/if}}></div>
      <p class="hint">{{localize "KRYNN.Settings.Dragons.FearCardsHint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "KRYNN.Settings.Table.Legend"}}</legend>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Steel.Label"}}</label>
      <div class="form-fields"><input type="checkbox" name="steelCurrency" {{#if steel}}checked{{/if}}></div>
      <p class="hint">{{localize "KRYNN.Settings.Steel.Hint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Daylight.Label"}}</label>
      <div class="form-fields"><input type="checkbox" name="sceneDaylight" {{#if daylight}}checked{{/if}}></div>
      <p class="hint">{{localize "KRYNN.Settings.Daylight.Hint"}}</p>
    </div>
    <div class="krynn-companions">
      <p><strong>{{localize "KRYNN.Settings.Companions.Title"}}</strong></p>
      <ul>{{#each companions}}<li><strong>{{title}}</strong> ({{state}}): {{text}}</li>{{/each}}</ul>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "KRYNN.Settings.Life.Legend"}}</legend>
    {{#if life.error}}<p class="hint">{{life.error}}</p>{{else}}
    <p class="hint">{{localize "KRYNN.Settings.Life.Hint"}}</p>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Life.Year"}}</label>
      <div class="form-fields">
        <select name="lw.yearMode">
          <option value="world" {{#if life.yearWorld}}selected{{/if}}>{{localize "KRYNN.Settings.Life.YearWorld"}}</option>
          <option value="fixed" {{#unless life.yearWorld}}selected{{/unless}}>{{localize "KRYNN.Settings.Life.YearFixed"}}</option>
        </select>
        <input type="number" name="lw.year" value="{{life.year}}" min="1" max="430" step="1" aria-label="{{localize "KRYNN.Settings.Date.Year"}}">
      </div>
      <p class="hint">{{life.summary}}{{#if life.clamped}} {{localize "KRYNN.Settings.Life.Clamped"}}{{/if}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Life.Region"}}</label>
      <div class="form-fields"><select name="lw.region">{{#each life.regions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Life.Start"}}</label>
      <div class="form-fields"><input type="text" name="lw.start" value="{{life.start}}" placeholder="{{localize "KRYNN.Settings.Life.StartHint"}}"></div>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Life.Scope"}}</label>
      <div class="form-fields"><select name="lw.scope">{{#each life.scopes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Life.Who"}}</label>
      <div class="form-fields"><select name="lw.who">
        <option value="everyone" {{#if life.whoEveryone}}selected{{/if}}>{{localize "KRYNN.Settings.Life.WhoEveryone"}}</option>
        <option value="gm" {{#unless life.whoEveryone}}selected{{/unless}}>{{localize "KRYNN.Settings.Life.WhoGM"}}</option>
      </select></div>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Life.NpcActors"}}</label>
      <div class="form-fields"><input type="checkbox" name="lw.npcActors" {{#if life.npcActors}}checked{{/if}}></div>
      <p class="hint">{{localize "KRYNN.Settings.Life.NpcActorsHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "KRYNN.Settings.Life.KrynnHeritages"}}</label>
      <div class="form-fields"><input type="checkbox" name="lw.krynnHeritages" {{#if life.krynnHeritages}}checked{{/if}}></div>
      <p class="hint">{{localize "KRYNN.Settings.Life.KrynnHeritagesHint"}}</p>
    </div>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>{{localize "KRYNN.SelfTest.Legend"}}</legend>
    <p class="hint">{{localize "KRYNN.SelfTest.Hint"}}</p>
    <button type="button" data-action="selfTest"><i class="fa-solid fa-stethoscope"></i> {{localize "KRYNN.SelfTest.Run"}}</button>
  </fieldset>
</section>
